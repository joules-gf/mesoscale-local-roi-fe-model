<input>
    
    <domain>
        <shape> square </shape>
        <side_length> 1 </side_length>
    </domain>

    <material>
        <name> Phase-0 </name>
        <shape> circle </shape>
        <fraction> 0.1 </fraction>
        <size>
            <dist_type> uniform </dist_type>
            <loc> 0.05 </loc>
        </size>
    </material>
    
    <material>
        <name> Phase-1 </name>
        <shape> circle </shape>
        <fraction> 0.1 </fraction>
        <size>
            <dist_type> uniform </dist_type>
            <loc> 0.05 </loc>
        </size>
    </material>

    <material>
        <name> Phase-2 </name>
        <shape> circle </shape>
        <fraction> 0.4 </fraction>
        <size>
            <dist_type> uniform </dist_type>
            <loc> 0.05 </loc>
        </size>
    </material>
    
    <material>
        <name> Phase-3 </name>
        <shape> circle </shape>
        <fraction> 0.4 </fraction>
        <size>
            <dist_type> uniform </dist_type>
            <loc> 0.05 </loc>
        </size>
    </material>

    <settings>
        <verbose> True </verbose>
        <restart> True </restart>

        <mesh_min_angle> 25 </mesh_min_angle>
        <mesh_max_edge_length> 0.1 </mesh_max_edge_length>

        <rng_seeds>
            <size> 1000 </size>
        </rng_seeds>

        <filetypes>
            <seeds_plot> png </seeds_plot>
            <poly_plot> png </poly_plot>
            <tri> abaqus </tri>
            <tri_plot> png </tri_plot>
            <verify_plot> pdf </verify_plot>
        </filetypes>
    </settings>

    <abaqus>
        <reference_material> AA7075-T6 </reference_material>
        <E> auto </E>
        <nu> 0.33 </nu>
        <displacement_yy> 0.01 </displacement_yy>
        <plastic_stresses> 350, 470, 891, 891 </plastic_stresses>

        <num_increments_step> 125 </num_increments_step>
    </abaqus>

</input>